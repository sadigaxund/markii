{
  "name": "@markii/stdlib",
  "version": "0.3.1",
  "description": "Neutral, framework-agnostic standard component contracts for Mark (.mk.md) — the kind/attribute-schema seam every renderer (e.g. @markii/react) implements against. No React, zero dependencies.",
  "keywords": [
    "markdown",
    "mark",
    "mk.md",
    "stdlib",
    "contracts",
    "directive"
  ],
  "license": "MIT",
  "author": "sadigaxund",
  "homepage": "https://github.com/sadigaxund/markii#readme",
  "bugs": "https://github.com/sadigaxund/markii/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadigaxund/markii.git",
    "directory": "packages/markii-stdlib"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint ."
  }
}
