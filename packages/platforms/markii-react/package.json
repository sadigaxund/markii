{
  "name": "@markii/react",
  "version": "0.3.1",
  "description": "The reference React renderer for Mark (.mk.md): a registry-driven hast-to-React renderer (`.`), an optional standard component set + defaultRegistry (`./components`), and the document stylesheet (`./doc.css`).",
  "keywords": [
    "markdown",
    "mark",
    "mk.md",
    "react",
    "renderer",
    "directive",
    "components"
  ],
  "license": "MIT",
  "author": "sadigaxund",
  "homepage": "https://github.com/sadigaxund/markii#readme",
  "bugs": "https://github.com/sadigaxund/markii/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadigaxund/markii.git",
    "directory": "packages/platforms/markii-react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./doc.css": "./dist/doc.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json && cp src/doc.css dist/doc.css",
    "lint": "eslint ."
  },
  "dependencies": {
    "hast-util-to-jsx-runtime": "^2.3.6",
    "@markii/core": "0.3.1",
    "@markii/runtime": "0.3.1",
    "@markii/stdlib": "0.3.1"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
