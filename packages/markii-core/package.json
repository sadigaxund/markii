{
  "name": "@markii/core",
  "version": "0.3.1",
  "description": "Framework-agnostic reference parser for Mark (.mk.md): CommonMark + directives to mdast, and mdast to a sanitized hast tree. Zero React dependency.",
  "keywords": [
    "markdown",
    "mark",
    "mk.md",
    "mdast",
    "hast",
    "unified",
    "directive",
    "parser"
  ],
  "license": "MIT",
  "author": "sadigaxund",
  "homepage": "https://github.com/sadigaxund/markii#readme",
  "bugs": "https://github.com/sadigaxund/markii/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadigaxund/markii.git",
    "directory": "packages/markii-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./corpus": {
      "types": "./dist/corpus.d.ts",
      "import": "./dist/corpus.js",
      "default": "./dist/corpus.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "corpus:regen": "node scripts/regen-corpus.ts"
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "mdast-util-directive": "^3.1.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
