{
  "name": "markii-vscode",
  "displayName": "Markii",
  "description": "Preview for Markii (.mk.md) documents: CommonMark plus directives that render components.",
  "version": "0.3.1",
  "private": true,
  "license": "MIT",
  "publisher": "sadigaxund",
  "author": "sadigaxund",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadigaxund/markii.git",
    "directory": "apps/vscode"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "languages": [
      {
        "id": "markdown",
        "extensions": [
          ".mk.md"
        ]
      }
    ],
    "commands": [
      {
        "command": "markii.openPreview",
        "title": "Open Preview",
        "category": "Markii",
        "icon": "$(open-preview)"
      },
      {
        "command": "markii.runScripts",
        "title": "Run Scripts",
        "category": "Markii",
        "icon": "$(play)"
      },
      {
        "command": "markii.resetScriptGrants",
        "title": "Reset Script Grants",
        "category": "Markii"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markii.openPreview",
          "when": "resourceFilename =~ /\\.mk\\.md$/",
          "group": "navigation@1"
        },
        {
          "command": "markii.runScripts",
          "when": "(resourceFilename =~ /\\.mk\\.md$/ && markii.previewActive) || activeWebviewPanelId == 'markii.preview'",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "markii.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markii.runScripts",
          "when": "markii.previewActive"
        },
        {
          "command": "markii.resetScriptGrants",
          "when": "editorLangId == markdown || markii.previewActive"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markii.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && resourceFilename =~ /\\.mk\\.md$/"
      }
    ],
    "grammars": [
      {
        "scopeName": "markdown.markii.injection",
        "path": "./syntaxes/markii-directives.injection.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs --production",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@markii/core": "*",
    "@markii/lua": "*",
    "@markii/react": "*",
    "@markii/runtime": "*"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12"
  }
}
